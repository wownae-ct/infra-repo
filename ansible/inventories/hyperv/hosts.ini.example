# Hyper-V 환경 inventory 예시입니다. hosts.ini로 복사해 실제 값을 채우고, 그 파일은 커밋하지 않습니다.
# bastion만 직접 접속하고, 나머지 호스트는 ~/.ssh/config의 bastion-internal 별칭으로 ProxyJump 합니다.

[bastion]
bastion ansible_host=10.99.1.10 ansible_user=<user> ansible_ssh_private_key_file=<path> ansible_port=<port>

[storage]
storage ansible_host=10.99.2.20 ansible_user=<user> ansible_ssh_private_key_file=<path> ansible_port=<port> ansible_ssh_common_args='-o ProxyJump=bastion-internal'

[db]
db ansible_host=10.99.2.21 ansible_user=<user> ansible_ssh_private_key_file=<path> ansible_port=<port> ansible_ssh_common_args='-o ProxyJump=bastion-internal'

[k8s_masters]
k8s-master-01 ansible_host=10.99.3.11
k8s-master-02 ansible_host=10.99.3.12
k8s-master-03 ansible_host=10.99.3.13

[k8s_workers]
k8s-worker-01 ansible_host=10.99.3.21
k8s-worker-02 ansible_host=10.99.3.22
k8s-worker-03 ansible_host=10.99.3.23

[k8s_cluster:children]
k8s_masters
k8s_workers

[k8s_cluster:vars]
ansible_user=<user>
ansible_ssh_private_key_file=<path>
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyJump=bastion-internal'

[infra:children]
bastion
storage
db
