# /etc/default/minio - managed by Ansible (storage role)
# MinIO single-node single-drive 환경변수.

# 자격증명 (vault)
MINIO_ROOT_USER={{ storage_minio_root_user }}
MINIO_ROOT_PASSWORD={{ storage_minio_root_password }}

# 데이터 디렉토리
MINIO_VOLUMES="{{ storage_minio_data_dir }}"

# 네트워크
MINIO_OPTS="--address {{ storage_minio_api_address }} --console-address {{ storage_minio_console_address }}"

# 외부 URL (도메인 / reverse proxy 통한 외부 접근)
MINIO_SERVER_URL="{{ storage_minio_server_url }}"
MINIO_BROWSER_REDIRECT_URL="{{ storage_minio_browser_redirect_url }}"

# 도메인 (path-style + virtual-host-style 둘 다 지원)
MINIO_DOMAIN="{{ storage_minio_domain }}"

# CORS
MINIO_API_CORS_ALLOW_ORIGIN="{{ storage_minio_cors_allow_origin }}"

# Browser
MINIO_BROWSER={{ storage_minio_browser }}
MINIO_BROWSER_SECURITY_HEADERS={{ storage_minio_browser_security_headers }}

# 로깅
MINIO_LOG_LEVEL={{ storage_minio_log_level }}
MINIO_HTTP_TRACE={{ storage_minio_http_trace }}
