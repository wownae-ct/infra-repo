# {{ ansible_managed }}
# AWS credentials Secret — CronJob initContainer 의 env 소스.
# Vault 에서 주입 (파일 권한 0600 + no_log).
#
# stringData 대신 data (base64) 사용.
#   stringData 는 서버에서 매번 변경으로 판정되어 멱등성 깨짐.
#   data 는 서버 저장 형식과 동일해 unchanged 정확히 인식.
apiVersion: v1
kind: Secret
metadata:
  name: {{ ecr_aws_creds_secret }}
  namespace: {{ ecr_namespace }}
  labels:
    app.kubernetes.io/name: ecr-credentials-refresh
    app.kubernetes.io/managed-by: ansible
type: Opaque
data:
  AWS_ACCESS_KEY_ID: {{ ecr_aws_access_key | b64encode }}
  AWS_SECRET_ACCESS_KEY: {{ ecr_aws_secret_key | b64encode }}
  AWS_DEFAULT_REGION: {{ ecr_region | b64encode }}
