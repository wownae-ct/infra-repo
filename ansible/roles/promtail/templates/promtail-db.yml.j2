# {{ ansible_managed }}
# /etc/promtail/config.yml — db 서버 (Ubuntu 22.04)
#
# 수집 대상:
#   1. mariadb.service (journal)
#   2. MariaDB error log (파일, multiline)
#   3. MariaDB slow query log (파일, multiline)
#   4. 시스템 로그 (Ubuntu: syslog, auth.log)
#   5. SSH 무차별 공격 탐지 (auth.log)
#
# 참고:
#   - slow query log 는 MariaDB 설정에서 활성화해야 파일 생성됨
#     (/etc/mysql/mariadb.conf.d/ 에서 slow_query_log = 1)
#   - 파일 없으면 해당 job 은 조용히 skip (promtail 기본 동작)

server:
  http_listen_port: {{ promtail_http_port_db }}
  grpc_listen_port: 0

positions:
  filename: {{ promtail_positions_dir }}/positions-db.yaml

clients:
  - url: {{ promtail_loki_push_url }}
    tenant_id: {{ promtail_loki_tenant_id }}

scrape_configs:
  # ──────────────────────────────────────
  # 1. MariaDB (journal)
  # ──────────────────────────────────────
  - job_name: mariadb_journal
    journal:
      labels:
        job: mariadb
        host: {{ ansible_hostname }}
      matches: _SYSTEMD_UNIT=mariadb.service
    relabel_configs:
      - source_labels: ['__journal_priority_keyword']
        target_label: level

  # ──────────────────────────────────────
  # 2. MariaDB Error Log (파일 기반, multiline)
  # ──────────────────────────────────────
  # 기본 경로: /var/log/mysql/error.log
  # multiline: 날짜로 시작하는 줄이 새 엔트리
  - job_name: mariadb-error
    static_configs:
      - targets: [localhost]
        labels:
          job: mariadb-error
          host: {{ ansible_hostname }}
          __path__: /var/log/mysql/error.log
    pipeline_stages:
      - multiline:
          firstline: '^\d{4}-\d{2}-\d{2}'
          max_lines: 64
          max_wait_time: 3s
      - regex:
          expression: '\[(?P<level>Note|Warning|ERROR)\]'
      - labels:
          level:

  # ──────────────────────────────────────
  # 3. MariaDB Slow Query Log (파일 기반, multiline)
  # ──────────────────────────────────────
  # 기본 경로: /var/log/mysql/mariadb-slow.log
  # multiline: "# Time:" 으로 시작하는 줄이 새 엔트리
  # 파일 없으면 promtail 이 자동 skip (에러 아님)
  - job_name: mariadb-slowquery
    static_configs:
      - targets: [localhost]
        labels:
          job: mariadb-slow
          host: {{ ansible_hostname }}
          __path__: /var/log/mysql/mariadb-slow.log
    pipeline_stages:
      - multiline:
          firstline: '^# Time:'
          max_lines: 128
          max_wait_time: 3s
      - regex:
          expression: '# Query_time: (?P<query_time>\S+)\s+Lock_time: (?P<lock_time>\S+)\s+Rows_sent: (?P<rows_sent>\d+)\s+Rows_examined: (?P<rows_examined>\d+)'
      - labels:
          query_time:

  # ──────────────────────────────────────
  # 4. 시스템 로그 (Ubuntu: syslog, auth.log)
  # ──────────────────────────────────────
  - job_name: system-logs
    static_configs:
      - targets: [localhost]
        labels:
          job: system
          host: {{ ansible_hostname }}
          __path__: /var/log/{syslog,auth.log}

  # ──────────────────────────────────────
  # 5. SSH 무차별 공격 탐지 (Ubuntu: auth.log)
  # ──────────────────────────────────────
  - job_name: ssh-auth
    static_configs:
      - targets: [localhost]
        labels:
          job: ssh
          host: {{ ansible_hostname }}
          __path__: /var/log/auth.log
    pipeline_stages:
      - match:
          selector: '{job="ssh"}'
          stages:
            - regex:
                expression: '(?P<action>Failed password|Invalid user|Connection closed by authenticating user) .* from (?P<src_ip>\d+\.\d+\.\d+\.\d+)'
            - labels:
                action:
                src_ip:
      - match:
          selector: '{job="ssh"}'
          stages:
            - regex:
                expression: '(?P<action>Accepted (?:password|publickey)) for (?P<user>\S+) from (?P<src_ip>\d+\.\d+\.\d+\.\d+)'
            - labels:
                action:
                user:
                src_ip:
