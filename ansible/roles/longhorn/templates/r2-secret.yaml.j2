# {{ ansible_managed }}
# Longhorn R2 backup credential
# vault 의 3 변수에서 가져옴: access_key_id / secret_access_key / endpoint

apiVersion: v1
kind: Secret
metadata:
  name: {{ longhorn_backup_secret_name }}
  namespace: {{ longhorn_namespace }}
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "{{ vault_longhorn_r2_access_key_id }}"
  AWS_SECRET_ACCESS_KEY: "{{ vault_longhorn_r2_secret_access_key }}"
  AWS_ENDPOINTS: "{{ vault_longhorn_r2_endpoint }}"
  # R2 는 region 무시하지만 client 가 요구하면 'auto' 넘김
  AWS_DEFAULT_REGION: "auto"
