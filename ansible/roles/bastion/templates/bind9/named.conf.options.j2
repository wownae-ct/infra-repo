// /etc/bind/named.conf.options - managed by Ansible (bastion role)

options {
    directory "/var/cache/bind";

    recursion yes;

    listen-on {
{% for ip in bastion_bind9_listen_on %}
        {{ ip }};
{% endfor %}
    };
    listen-on-v6 { none; };

    allow-query {
{% for cidr in bastion_bind9_allow_query %}
        {{ cidr }};
{% endfor %}
    };

    allow-recursion {
{% for cidr in bastion_bind9_allow_recursion %}
        {{ cidr }};
{% endfor %}
    };

    forwarders {
{% for fwd in bastion_bind9_forwarders %}
        {{ fwd }};
{% endfor %}
    };

    dnssec-validation auto;
};
