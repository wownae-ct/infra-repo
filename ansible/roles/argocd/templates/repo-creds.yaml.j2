# {{ ansible_managed }}
# argocd-repo-creds Secret — ArgoCD private repo 인증
# label "argocd.argoproj.io/secret-type: repo-creds" 가 있어야 ArgoCD 가 자동 인식
apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_repo_creds_secret_name }}
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repo-creds
type: Opaque
data:
  type: {{ argocd_repo_creds_type | b64encode }}
  url: {{ argocd_repo_creds_url_prefix | b64encode }}
  username: {{ argocd_repo_creds_username | b64encode }}
  password: {{ argocd_repo_creds_password | b64encode }}
