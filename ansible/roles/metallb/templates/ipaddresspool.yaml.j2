# {{ ansible_managed }}
# IPAddressPool — LoadBalancer 서비스에 할당할 IP 풀.
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ metallb_pool_name }}
  namespace: {{ metallb_namespace }}
spec:
  addresses:
{% for cidr in metallb_pool_addresses %}
    - "{{ cidr }}"
{% endfor %}
  autoAssign: {{ metallb_pool_auto_assign | string | lower }}
  avoidBuggyIPs: {{ metallb_pool_avoid_buggy_ips | string | lower }}
